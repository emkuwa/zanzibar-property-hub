# ZanziInvest – Frontend env (optional)
# Copy to .env and set for local dev or override production API.

# --- Edge / Supabase function fallback (server-side only, no VITE_ prefix) ---
# The public anon key for the Supabase edge function gateway (not a service-role key).
# SUPABASE_EDGE_URL=https://qmnpwinlvewbnjbruril.supabase.co/functions/v1/zanziinvest-referral
# SUPABASE_EDGE_ANON_KEY=your_supabase_anon_key_here

# Backend API base URL (no trailing slash). Omit in production on Vercel so the app uses same-origin HTTPS (/api/*).
# Dev: http://127.0.0.1:5051
# Prod (optional): https://api.zanziinvest.com — must be https:// if the site is served over HTTPS.
# VITE_API_BASE_URL=http://127.0.0.1:5051

# Dashboard iframe URL (optional). Default: dev http://localhost:5052, prod https://dashboard.zanziinvest.com
# VITE_DASHBOARD_URL=https://dashboard.zanziinvest.com

# SERVER ONLY: developer referrals (never prefix these with VITE_).
# SUPABASE_URL=https://your-project.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# RESEND_API_KEY=
# REFERRAL_FROM_EMAIL=ZanziInvest <referrals@your-verified-domain>
# CRON_SECRET=
# REFERRAL_RATE_LIMIT_SALT=
# REFERRAL_ALLOWED_ORIGINS=https://exact-preview-host.vercel.app

# Server-side Edge fallback (used when no service-role key is held on Vercel).
# SUPABASE_EDGE_URL=https://your-project.supabase.co/functions/v1/zanziinvest-referral
# SUPABASE_EDGE_ANON_KEY=
